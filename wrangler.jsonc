{
  // Cloudflare Workers static assets: the site is fully prerendered with `nuxt generate`.
  // A small Worker answers the voice room's socket; every other request is a static asset.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zackha",
  "compatibility_date": "2026-10-01",
  "main": "worker/room.ts",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/room/ws"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // www.zackha.com is redirected to the apex by a Redirect Rule in the Cloudflare dashboard.
  "routes": [
    { "pattern": "zackha.com", "custom_domain": true },
    { "pattern": "www.zackha.com", "custom_domain": true }
  ],
  // Serve the site only from its canonical domain.
  "workers_dev": false,
  "preview_urls": false
}
