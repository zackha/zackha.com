# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The voice room needs the microphone; nothing else on the site does.
/room
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
/room/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

# Nuxt build assets are content-hashed, so they can be cached forever.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Social preview cards change only when an article's title or date does.
/og/*
  Cache-Control: public, max-age=86400
